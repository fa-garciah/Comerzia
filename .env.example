# Copie este archivo como .env y ajuste los valores. .env no se sube al repo.

# URL donde realmente se sirve el sitio (canonical y og:). Vacía = https://comerzia.mx
SITE_URL=

# Buscadores bloqueados por defecto (<meta name="robots" noindex>).
# Ponga 1 SOLO cuando correo, teléfono, razón social y aviso de privacidad sean reales.
PUBLIC_ALLOW_INDEX=
