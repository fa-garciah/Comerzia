---
import { site, nav } from "../data/site";
import Logo from "./Logo.astro";

interface Props { overHero?: boolean }
const { overHero = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const links = nav.filter((n) => n.href !== "/contacto/");
---

<header class:list={["site-header", { "site-header--hero": overHero }]}>
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name}, inicio`}>
      <Logo size={30} />
      <span class="brand__word">{site.name.toLowerCase()}</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul role="list">
        {links.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["site-nav__link", { "is-active": isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="theme-toggle" type="button" aria-label="Cambiar tema claro u oscuro">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
        </svg>
      </button>
      <a class="btn btn--lime site-header__cta" href="/contacto/">Contacto</a>
      <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="wrap" aria-label="Menú móvil">
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="btn btn--lime" href="/contacto/">{site.cta}</a>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === "dark"
      : window.matchMedia("(prefers-color-scheme: dark)").matches;
  toggle?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("comerzia-theme", next); } catch {}
  });

  const burger = document.querySelector<HTMLButtonElement>(".burger");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    if (!burger || !menu) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menu.hidden = !open;
    root.classList.toggle("menu-open", open);
  };
  burger?.addEventListener("click", () => setOpen(burger.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
  window.matchMedia("(min-width: 800px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    transition: background var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  /* over a bosque hero: same green until the page scrolls */
  :global(html:not(.is-scrolled):not(.menu-open)) .site-header--hero {
    background: var(--forest);
    border-color: transparent;
    backdrop-filter: none;
    --text: #f1f5ea;
    --text-muted: rgb(241 245 234 / 0.76);
    --border-strong: rgb(255 255 255 / 0.34);
    --focus: var(--lime);
  }
  :global(html:not(.is-scrolled):not(.menu-open)) .site-header--hero :global(.logo-mark__tile) {
    fill: rgb(255 255 255 / 0.1);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }
  .brand__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .site-nav { margin-inline-start: auto; }
  .site-nav ul { display: flex; gap: var(--space-l); }
  .site-nav__link {
    position: relative;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out);
  }
  .site-nav__link:hover, .site-nav__link.is-active { color: var(--text); }
  .site-nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 1px;
    background: var(--lime);
  }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-xs); }
  .site-header__cta { min-height: 40px; padding: 0.5rem 1.1rem; }

  .theme-toggle, .burger {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle .i-moon { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle .i-moon { display: block; }
  }

  .burger { display: none; position: relative; }
  .burger span {
    position: absolute;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }
  .burger span:first-child { transform: translateY(-3px); }
  .burger span:last-child { transform: translateY(3px); }
  .burger[aria-expanded="true"] span:first-child { transform: rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--bg);
    padding-block: var(--space-l);
    overflow-y: auto;
  }
  .mobile-menu ul { display: grid; margin-bottom: var(--space-l); }
  .mobile-menu li a {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 799px) {
    .site-nav, .site-header__cta { display: none; }
    .site-header__actions { margin-inline-start: auto; }
    .burger { display: inline-grid; }
  }
</style>
