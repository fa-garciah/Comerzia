---
/**
 * La ruta ascendente. On wide screens each step sits one riser higher than
 * the last, and a lima line climbs through their markers. On narrow screens it
 * becomes a vertical rail read top to bottom — climbing sideways on a phone
 * would just mean scrolling sideways.
 */
interface Step { n: string; title: string; body: string }
interface Props { steps: readonly Step[] }
const { steps } = Astro.props;
---

<div class="ascent" style={`--count:${steps.length}`}>
  <svg class="ascent__line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <polyline
      points={steps
        .map((_, i) => {
          const x = (i / (steps.length - 1)) * 100;
          const y = 100 - (i / (steps.length - 1)) * 100;
          return `${x},${y}`;
        })
        .join(" ")}
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <ol class="ascent__steps" role="list">
    {steps.map((s, i) => (
      <li class="ascent__step" data-reveal style={`--i:${i};--delay:${i * 90}ms`}>
        <span class="ascent__marker" aria-hidden="true"></span>
        <span class="ascent__n">{s.n}</span>
        <h3>{s.title}</h3>
        <p class="muted">{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .ascent { position: relative; margin-top: var(--space-xl); }
  .ascent__line { display: none; }

  .ascent__steps {
    display: grid;
    gap: var(--space-l);
    padding-left: 28px;
    border-left: 2px solid var(--border);
  }
  .ascent__step { position: relative; }
  .ascent__marker {
    position: absolute;
    left: calc(-28px - 8px);
    top: 0.2rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--lime);
    border: 2.5px solid var(--forest);
  }
  .ascent__n {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }
  .ascent__step h3 { margin-bottom: 0.4rem; }

  /* ---- the staircase ---- */
  @media (min-width: 900px) {
    .ascent { --rise: 4.5rem; padding-top: calc(var(--rise) * (var(--count) - 1)); }

    .ascent__steps {
      grid-template-columns: repeat(var(--count), 1fr);
      gap: var(--space-l);
      padding-left: 0;
      border-left: 0;
    }
    .ascent__step {
      padding-top: var(--space-m);
      border-top: 2px solid var(--border-strong);
      margin-top: calc(var(--rise) * -1 * var(--i));
      align-self: start;
    }
    .ascent__marker { left: -8px; top: -8px; }

    /* the line runs marker to marker: first column's left edge, bottom
       step's top, to the last column's left edge, top step's top */
    .ascent__line {
      display: block;
      position: absolute;
      top: -1px;
      left: 0;
      width: calc((100% + var(--space-l)) * (var(--count) - 1) / var(--count));
      height: calc(var(--rise) * (var(--count) - 1));
      overflow: visible;
    }
    .ascent__line polyline {
      fill: none;
      stroke: var(--accent-text);
      stroke-width: 2.5;
      stroke-linecap: round;
    }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    /* the climb draws left to right once the steps come into view */
    :global(.js) .ascent__line { clip-path: inset(0 100% 0 0); transition: clip-path 1.4s var(--ease-out) 0.2s; }
    :global(.js) .ascent:has(.is-visible) .ascent__line { clip-path: inset(0 -10px 0 0); }
  }
</style>
